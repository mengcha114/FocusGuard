<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Screen capture -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- 锁机守护前台服务（Android 14+ 要求声明具体类型） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Overlay for blocking -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    
    <!-- Usage stats -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    
    <!-- Network for AI API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- 待办到期精确提醒（Android 12+ 可在系统设置中关闭，应用内降级为非精确） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Boot completed for auto-start -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- Battery optimization -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 全屏提醒（横屏/游戏等全屏场景也能弹出提醒，Android 14+ 需在通知设置里允许） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    
    <!-- 允许无障碍服务/应用收起与屏蔽系统状态栏/通知栏 -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Android 11+ 需要显式声明才能查询已安装应用列表 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Shizuku 管理器 / Dhizuku（高级权限增强，可选） -->
        <package android:name="moe.shizuku.manager" />
        <package android:name="com.rosan.dhizuku" />
    </queries>

    <!-- allowBackup=false：本应用处理屏幕内容日志与 API 密钥等敏感数据，
         禁止云备份与设备迁移，杜绝"备份文件泄露隐私/换机恢复带回过期锁机状态"。 -->
    <application
        android:name=".FocusGuardApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusGuard"
        tools:targetApi="34">

        <!-- Shizuku：binder 接收与授权回调（Shizuku API 必需） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 日志导出 FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FocusGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 从任意备忘录/便签 App 分享文本导入待办（每行一条） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 全屏提醒页（Full-Screen Intent 目标） -->
        <activity
            android:name=".enforce.AlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.FocusGuard.Alert"
            android:launchMode="singleTop"
            android:taskAffinity="" />

        <!-- 全局强制锁机界面 -->
        <activity
            android:name=".enforce.LockScreenActivity"
            android:exported="false"
            android:theme="@style/Theme.FocusGuard.Block"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:resizeableActivity="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|screenLayout|smallestScreenSize" />

        <!-- 解锁挑战答题页（独立窗口，避免输入法触发锁机页顶回循环） -->
        <activity
            android:name=".enforce.UnlockChallengeActivity"
            android:exported="false"
            android:theme="@style/Theme.FocusGuard.Block"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|screenLayout|smallestScreenSize" />

        <!-- 应用时长超限后的持续封锁界面 -->
        <activity
            android:name=".enforce.AppBlockActivity"
            android:exported="false"
            android:theme="@style/Theme.FocusGuard.Block"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Monitor service（AI 检测，需要 MediaProjection） -->
        <service
            android:name=".service.MonitorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 锁机守护前台服务（不依赖无障碍，使用情况权限即可工作） -->
        <!-- 锁机自愈闹钟接收器（杀后台后 5 秒内强制恢复锁机） -->
        <receiver
            android:name=".service.LockGuardAlarmReceiver"
            android:exported="false" />

        <service
            android:name=".service.LockGuardService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Accessibility service -->
        <service
            android:name=".access.GuardAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 开机自启动：恢复锁机状态 + 启动锁机守护服务 -->
        <receiver
            android:name=".boot.BootReceiver"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.USER_SWITCHED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 锁机期间媒体键拦截（蓝牙/线控长按语音助手入口） -->
        <receiver
            android:name=".service.MediaButtonBlocker"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- 待办到期提醒闹钟（AlarmManager 拉起，条目不存在时静默跳过） -->
        <receiver
            android:name=".service.MemoReminderReceiver"
            android:exported="false" />

    </application>

</manifest>
